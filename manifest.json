{
  "manifest_version": 3,
  "name": "SimpleReaderExtension",
  "version": "0.1.0",
  "description": "Save current page URL or rendered HTML to Readwise Reader.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Readwise Reader"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "service_worker.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://readwise.io/*"]
}

